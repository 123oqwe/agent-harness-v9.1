{
  "name": "agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/harness/index.js",
  "types": "./dist/harness/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "overrides": {
    "qs": "6.15.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint gateway security index.ts tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contracts tests/api",
    "test:unit": "vitest run tests/gateway tests/policy tests/security tests/capability tests/state-machines tests/spikes tests/packaging",
    "test:integration": "vitest run tests/gateway tests/security/capability-replay.test.ts tests/capability",
    "test:security": "vitest run tests/threat-model tests/gateway tests/policy tests/security tests/capability",
    "test:e2e": "vitest run tests/contracts tests/gateway",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "node scripts/run-stryker.mjs",
    "format": "prettier --write gateway security index.ts tests *.config.* *.json scripts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/bcrypt": "6.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.2",
    "bcrypt": "6.0.0",
    "better-sqlite3": "12.11.1"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "..",
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@harness/*": ["./*"],
      "@contracts/*": ["../spec/contracts/*"],
      "@spec-types/*": ["../spec/types/*"]
    }
  },
  "include": ["./**/*.ts", "../spec/types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/verification/schemas/phase2-mutation-publication-receipt/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commit_sha", "tree_sha", "batch_sha256", "publication_path", "publication_set_sha256", "candidate_report_sha256", "execution_receipt_sha256"],
  "properties": {
    "schema_version": { "const": "phase2-mutation-publication-receipt/v2" },
    "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "tree_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "batch_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publication_path": { "type": "string", "pattern": "^reports/phase2/mutation-publications/[a-f0-9]{64}$" },
    "publication_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "execution_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

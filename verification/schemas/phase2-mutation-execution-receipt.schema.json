{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/verification/schemas/phase2-mutation-execution-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "child_exit_status", "runner_sha256", "configuration_sha256", "source_snapshot_sha256", "dependency_snapshot_sha256", "dependency_manifest_sha256", "authority_closure_sha256", "mutant_completeness_sha256", "toolchain", "isolation_mechanism"],
  "properties": {
    "schema_version": { "const": "phase2-mutation-execution-receipt/v1" },
    "child_exit_status": { "const": 0 },
    "runner_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "configuration_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dependency_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dependency_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_closure_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mutant_completeness_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "toolchain": { "type": "object", "additionalProperties": false, "required": ["node_version", "node_sha256", "npm_version", "npm_sha256", "registry", "bubblewrap_version", "bubblewrap_sha256", "prlimit_sha256"], "properties": { "node_version": { "const": "v20.18.1" }, "node_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "npm_version": { "const": "10.8.2" }, "npm_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "registry": { "const": "https://registry.npmjs.org/" }, "bubblewrap_version": { "const": "bubblewrap 0.6.1" }, "bubblewrap_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "prlimit_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "isolation_mechanism": { "const": "bubblewrap" }
  }
}

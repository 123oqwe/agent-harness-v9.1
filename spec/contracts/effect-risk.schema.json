{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EffectRisk",
  "description": "Dynamic risk features. Replaces static tool risk classification.",
  "type": "object",
  "required": [
    "locality",
    "operation",
    "reversibility",
    "data_egress",
    "network_access",
    "credential_access",
    "blast_radius",
    "financial_impact_usd_micros",
    "human_impact",
    "external_visibility",
    "regulatory_sensitivity"
  ],
  "properties": {
    "locality": {
      "enum": [
        "local",
        "remote",
        "external"
      ]
    },
    "operation": {
      "enum": [
        "read",
        "create",
        "write",
        "delete",
        "execute",
        "publish",
        "communicate",
        "purchase"
      ]
    },
    "reversibility": {
      "enum": [
        "guaranteed",
        "best_effort",
        "none"
      ]
    },
    "data_egress": {
      "enum": [
        "none",
        "metadata",
        "content",
        "sensitive"
      ]
    },
    "network_access": {
      "type": "boolean",
      "description": "Summary boolean. Authoritative network control lives in egress_policy. Kept for backward-compatible risk scoring."
    },
    "egress_policy": {
      "type": "object",
      "description": "Authoritative network policy (FG3). Replaces boolean network_access as the enforcement target. network_access remains as a derived summary for risk scoring.",
      "properties": {
        "mode": {
          "enum": [
            "disabled",
            "allowlist",
            "denylist",
            "open"
          ]
        },
        "domain_rules": {
          "type": "array",
          "description": "Ordered allow/deny rules. deny always wins. Supports exact hosts, scoped wildcards (*.example.com), and global *.",
          "items": {
            "type": "object",
            "required": [
              "action",
              "host"
            ],
            "properties": {
              "action": {
                "enum": [
                  "allow",
                  "deny"
                ]
              },
              "host": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "unix_sockets": {
          "enum": [
            "denied",
            "allowlist"
          ]
        },
        "allow_local_binding": {
          "type": "boolean",
          "description": "Default false: blocks local/private-network destinations unless explicitly allowed."
        },
        "socks5": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "screen_access": {
      "type": "object",
      "description": "Screen/desktop operation risk dimensions (FG1 Computer Use). Absent = no screen access.",
      "properties": {
        "surface": {
          "enum": [
            "none",
            "browser",
            "native_app",
            "desktop",
            "fullscreen"
          ]
        },
        "input_modes": {
          "type": "array",
          "items": {
            "enum": [
              "screenshot",
              "click",
              "type",
              "key",
              "clipboard"
            ]
          }
        },
        "app_scope": {
          "enum": [
            "per_app_approved",
            "workspace",
            "system"
          ]
        }
      },
      "additionalProperties": false
    },
    "credential_access": {
      "type": "boolean"
    },
    "blast_radius": {
      "enum": [
        "single_resource",
        "bounded_set",
        "workspace",
        "organization",
        "public",
        "unbounded"
      ]
    },
    "financial_impact_usd_micros": {
      "type": "string",
      "description": "Decimal string, e.g. '5000000' for $5.00"
    },
    "human_impact": {
      "enum": [
        "none",
        "self",
        "internal_people",
        "external_people",
        "public"
      ]
    },
    "external_visibility": {
      "enum": [
        "private",
        "shared",
        "public"
      ]
    },
    "regulatory_sensitivity": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
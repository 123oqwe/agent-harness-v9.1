{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunDefaults",
  "description": "Default values only. NOT an execution contract. RunPlan is the only normative execution contract.",
  "required": [
    "default_model",
    "default_tools",
    "default_budget"
  ],
  "properties": {
    "default_model": {
      "type": "object"
    },
    "default_tools": {
      "type": "array"
    },
    "default_budget": {
      "type": "object"
    }
  },
  "type": "object",
  "additionalProperties": false
}
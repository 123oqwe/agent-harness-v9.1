{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreamEvent",
  "type": "object",
  "required": [
    "event_id",
    "sequence",
    "run_id",
    "type",
    "timestamp",
    "payload",
    "redaction_applied"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "run_id": {
      "type": "string"
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "redaction_applied": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
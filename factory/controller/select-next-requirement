#!/usr/bin/env python3
import json, sys
base = sys.argv[1] if len(sys.argv) > 1 else "."
with open(f"{base}/requirements/requirements.ndjson") as f:
    for l in f:
        if l.strip():
            r = json.loads(l)
            if r.get("implementation_maturity") == "not_started":
                print(r["id"])
                sys.exit(0)
print("NONE")

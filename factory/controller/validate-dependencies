#!/usr/bin/env python3
import json, sys
req_id = sys.argv[1]
base = sys.argv[2] if len(sys.argv) > 2 else "."
with open(f"{base}/requirements/requirements.ndjson") as f:
    reqs = {json.loads(l)["id"]: json.loads(l) for l in f if l.strip()}
if req_id not in reqs:
    print(f"ERROR: {req_id} not found"); sys.exit(1)
for dep in reqs[req_id].get("dependencies", []):
    if dep not in reqs:
        print(f"FAIL: {dep} does not exist"); sys.exit(1)
    if reqs[dep].get("implementation_maturity") != "verified":
        print(f"FAIL: {dep} not verified"); sys.exit(1)
print("PASS: All dependencies verified")
